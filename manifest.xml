<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>9c6a6f91-6e13-4a3f-9f3a-8f5d6e9b3d21</Id>

  <Version>1.0.0.0</Version>

  <ProviderName>FLRSGLOBAL</ProviderName>

  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName
    DefaultValue="The Pleasure Dispatch by FLRSGLOBAL"/>

  <Description
    DefaultValue="Create The Pleasure Dispatch directly inside Outlook."/>

  <IconUrl
    DefaultValue="https://flrsgloba.github.io/dispatch.flrsglobal.com/assets/icon-64.png"/>

  <HighResolutionIconUrl
    DefaultValue="https://flrsgloba.github.io/dispatch.flrsglobal.com/assets/icon-128.png"/>

  <SupportUrl
    DefaultValue="https://flrsgloba.github.io/dispatch.flrsglobal.com/"/>

  <AppDomains>

    <AppDomain>
      https://flrsgloba.github.io
    </AppDomain>

  </AppDomains>

  <Hosts>

    <Host Name="Mailbox"/>

  </Hosts>

  <Requirements>

    <Sets>

      <Set Name="Mailbox" MinVersion="1.1"/>

    </Sets>

  </Requirements>

  <FormSettings>

    <Form xsi:type="ItemEdit">

      <DesktopSettings>

        <SourceLocation
          DefaultValue="https://flrsgloba.github.io/dispatch.flrsglobal.com/src/taskpane.html"/>

      </DesktopSettings>

    </Form>

  </FormSettings>

  <Permissions>
    ReadWriteMailbox
  </Permissions>

  <Rule
    xsi:type="RuleCollection"
    Mode="Or">

    <Rule
      xsi:type="ItemIs"
      ItemType="Message"
      FormType="Edit"/>

  </Rule>

  <DisableEntityHighlighting>
    false
  </DisableEntityHighlighting>

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Requirements>

      <bt:Sets DefaultMinVersion="1.3">

        <bt:Set Name="Mailbox"/>

      </bt:Sets>

    </Requirements>

    <Hosts>

      <Host xsi:type="MailHost">

        <DesktopFormFactor>

          <ExtensionPoint
            xsi:type="MessageComposeCommandSurface">

            <OfficeTab id="TabDefault">

              <Group id="PleasureDispatchGroup">

                <Label
                  resid="groupLabel"/>

                <Control
                  xsi:type="Button"
                  id="OpenPleasureDispatch">

                  <Label
                    resid="buttonLabel"/>

                  <Supertip>

                    <Title
                      resid="buttonLabel"/>

                    <Description
                      resid="buttonDescription"/>

                  </Supertip>

                  <Icon>

                    <bt:Image
                      size="16"
                      resid="icon16"/>

                    <bt:Image
                      size="32"
                      resid="icon32"/>

                    <bt:Image
                      size="80"
                      resid="icon80"/>

                  </Icon>

                  <Action xsi:type="ShowTaskpane">

                    <SourceLocation
                      resid="taskpaneUrl"/>

                  </Action>

                </Control>

              </Group>

            </OfficeTab>

          </ExtensionPoint>

        </DesktopFormFactor>

      </Host>

    </Hosts>

    <Resources>

      <bt:Images>

        <bt:Image
          id="icon16"
          DefaultValue="https://flrsgloba.github.io/dispatch.flrsglobal.com/assets/icon-16.png"/>

        <bt:Image
          id="icon32"
          DefaultValue="https://flrsgloba.github.io/dispatch.flrsglobal.com/assets/icon-32.png"/>

        <bt:Image
          id="icon80"
          DefaultValue="https://flrsgloba.github.io/dispatch.flrsglobal.com/assets/icon-80.png"/>

      </bt:Images>

      <bt:Urls>

        <bt:Url
          id="taskpaneUrl"
          DefaultValue="https://flrsgloba.github.io/dispatch.flrsglobal.com/src/taskpane.html"/>

      </bt:Urls>

      <bt:ShortStrings>

        <bt:String
          id="groupLabel"
          DefaultValue="FLRSGLOBAL"/>

        <bt:String
          id="buttonLabel"
          DefaultValue="The Pleasure Dispatch"/>

      </bt:ShortStrings>

      <bt:LongStrings>

        <bt:String
          id="buttonDescription"
          DefaultValue="Open the FLRSGLOBAL Pleasure Dispatch composer."/>

      </bt:LongStrings>

    </Resources>

  </VersionOverrides>

</OfficeApp>
